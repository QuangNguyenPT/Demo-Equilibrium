# secrets and local machine state
.env
.claude/settings.local.json
.claude/.index-stale
.obsidian/workspace*.json

# python
__pycache__/
*.pyc
.pytest_cache/

# trained artifacts and downloaded datasets (reproducible, large)
models/
runs/
*.hrmc
knowledge*.pt
data/external/

# large reference downloads and graphify's per-file cache
docs/*.zip
graphify-out/cache/

# generated vault notes (graphify obsidian export to vault root — real notes are in subdirs)
vault/*.md
vault/*.canvas
vault/_graph-view/
vault/graph.canvas

# graphify backup temp dirs and per-run intermediates (graph.json + manifest are the tracked outputs)
.gfy-replace-bak-*.tmp/
graphify-out/2026-*/
graphify-out/graph.html
graphify-out/.graphify_ast.json
graphify-out/.graphify_cached.json
graphify-out/.graphify_detect.json
graphify-out/.graphify_python
graphify-out/.graphify_uncached.txt
vault/.obsidian/

# scratch canvas files
Untitled*.canvas

# native build output (rebuild with scripts/build_native.ps1)
hrm_x/native/bin/
